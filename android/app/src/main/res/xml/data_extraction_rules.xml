<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ の Auto Backup（cloud-backup）と D2D 端末間転送（device-transfer）の層別ルール。
  内容・理由は backup_rules.xml（API<31）と同一＝ADR 0015 参照。
  D2D は 25MB 上限が無いが、ルールを揃える理由: 転送経路によって復元結果（実体の有無）が
  変わると「同じ復元なのに片方だけ本文がある」という予測不能な差を生むため、
  全経路で〈メタデータ層のみ・本文は再取込〉に統一する。
-->
<data-extraction-rules>
    <!-- include 方式＝列挙のみが対象。HTML 実体（files/novels/）は構造的に対象外
         （明示 exclude は lint「included path 内にない exclude」エラーになるため書かない）。 -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
