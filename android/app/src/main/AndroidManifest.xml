<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- なろう公式API(api.syosetu.com)からのランキング/検索/作品情報メタ取得に加え、WebViewでのWeb小説表示、および縦書きPDFのダウンロードに使用する。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      層別 Auto Backup（ADR 0015・旧 allowBackup=false 判断を上書き）:
      旧判断は「25MB 上限で HTML だけ部分欠落→DB と実体の不整合」を恐れて全無効化していたが、
      端末喪失で蔵書リスト・読書位置・設定まで全損する（公理18・2026-07-12 監査 Critical）。
      対処は層別＝include をメタデータ層（Room DB・SharedPreferences・DataStore＝数十KB）に限定し、
      不整合の原因だった HTML 実体（files/novels/）を除外する。復元後に実体が無いケースは
      「再取込が必要」への graceful degrade（読書位置は保持）で構造対処するため、
      旧判断が恐れた resolvedFile==null の行き止まりは成立しなくなる。
      ルール本体: API31+ は @xml/data_extraction_rules、API26-30 は @xml/backup_rules。
    -->
    <!-- enableOnBackInvokedCallback=true: Predictive Back（戻りプレビュー）へのオプトイン（API 33+。それ未満では無視される）。
         ルート（本棚タブ page 0）ではアプリ側の Back 割込みが全て enabled=false になるため、システムの
         「ホームへ戻る」プレビューアニメがそのまま効く。深い画面の BackHandler は activity-compose の
         OnBackInvokedDispatcher 互換層経由で従来どおり動く（挙動変化なし）。 -->
    <application
        android:name=".NovelReaderApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovelReader">

        <!-- launchMode=singleTop: 変換完了通知タップ（M11 deep link）が Activity 稼働中に来たとき、
             新規インスタンスを積まず既存へ onNewIntent で届けるため。多重起動を避けつつ着地先を決定化する。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              P3 取込導線その1（任意サイトの共有受け）: 他アプリの「共有」→本アプリ。
              ホスト制限を掛けない＝どのサイトの共有でも受け、対応可否のゲートはアプリ内 registry
              （SiteAdapterRegistry）で判定する（Supported=取込／Blocked=公式サイト送り／Unsupported=未対応案内）。
              URL はテキスト本文（EXTRA_TEXT）から WebImportIntentParser が抽出する。
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              P3 取込導線その2（対応サイトのリンクタップ受け）: ブラウザ等でのリンクタップ→本アプリ。
              なぜ全 http/https にせず host を対応サイト（kakuyomu・akatsuki）に限定するか:
              (1) 全リンクのブラウザ候補に本アプリが常時出るのは UX 破壊。
              (2) Blocked サイト（なろう等）のリンクまで横取りして「公式で読んで」と返すのは本末転倒。
              任意サイトの受け口は上の ACTION_SEND が担うため、VIEW は自前 DL 可能な対応ホストだけに絞る。
              data 属性は filter 内でプールされ scheme×host の直積で照合される
              （http/https × kakuyomu.jp/www.kakuyomu.jp/akatsuki-novels.com/www.akatsuki-novels.com）
              ＝1タグ1属性に分割（IntentFilterUniqueDataAttributes 準拠・「組で束縛される」誤読を防ぐ。マッチ集合は同一）。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="kakuyomu.jp" />
                <data android:host="www.kakuyomu.jp" />
                <data android:host="akatsuki-novels.com" />
                <data android:host="www.akatsuki-novels.com" />
            </intent-filter>
        </activity>

        <service
            android:name=".PdfProcessingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
          WorkManager の自動初期化を無効化し on-demand 初期化（NovelReaderApplication が
          Configuration.Provider を実装）へ切り替える。
          なぜ: 自動初期化は androidx.startup の ContentProvider 経由で、Robolectric（JVM UI テスト
          ＝ADR 0009）では走らず WorkManager.getInstance が IllegalStateException で全テストを
          落とすため。on-demand なら本番・テストとも「最初に使う瞬間」に同じ経路で初期化される。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <!--
          なろう縦書きPDF取り込み（ADR 0011）の DL 一時ファイルを content:// 化するための FileProvider。
          なぜ必要か: 既存の取り込み経路 PdfProcessingService は content:// URI を前提にしており
          （openInputStream + FLAG_GRANT_READ_URI_PERMISSION）、WebView の setDownloadListener が返す
          直リンク（http(s)）や cacheDir 上の File(file://) をそのまま渡せない。FileProvider で
          自パッケージ配下の一時 PDF を content:// として安全に受け渡す。
          exported=false + grantUriPermissions=true: 外部には晒さず、Intent の一時権限付与でのみ読ませる。
          公開範囲は @xml/file_paths（cacheDir/pdf_import/ の一点のみ）に限定する。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
