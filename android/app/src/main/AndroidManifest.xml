<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- なろう公式API(api.syosetu.com)からランキング/検索/作品情報メタを取得するため。本文取得はしない。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup を false にする理由:
      蔵書の本文は filesDir/novels/{bookId}/*.html に保存され、DB(books) はその絶対パスを持つ。
      Auto Backup には 25MB 上限があり、蔵書がこれを超えると HTML だけが部分的にバックアップ
      されず DB だけ復元される → 復元後に書籍を開くと実体が無く「書籍データが見つかりません」に
      なる（NativeReadingScreen の resolvedFile==null）。DB とファイル実体の整合を Auto Backup で
      保証できないため、壊れる可能性のあるバックアップより無効化を選ぶ。
    -->
    <application
        android:name=".NovelReaderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovelReader">

        <!-- launchMode=singleTop: 変換完了通知タップ（M11 deep link）が Activity 稼働中に来たとき、
             新規インスタンスを積まず既存へ onNewIntent で届けるため。多重起動を避けつつ着地先を決定化する。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PdfProcessingService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
          なろう縦書きPDF取り込み（ADR 0011）の DL 一時ファイルを content:// 化するための FileProvider。
          なぜ必要か: 既存の取り込み経路 PdfProcessingService は content:// URI を前提にしており
          （openInputStream + FLAG_GRANT_READ_URI_PERMISSION）、WebView の setDownloadListener が返す
          直リンク（http(s)）や cacheDir 上の File(file://) をそのまま渡せない。FileProvider で
          自パッケージ配下の一時 PDF を content:// として安全に受け渡す。
          exported=false + grantUriPermissions=true: 外部には晒さず、Intent の一時権限付与でのみ読ませる。
          公開範囲は @xml/file_paths（cacheDir/pdf_import/ の一点のみ）に限定する。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.novelreader.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
