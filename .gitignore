novel_app/
library/progress.json
library/books.json

# Android ビルド成果物・ローカル設定
android/.gradle/
android/build/
android/app/build/
android/macrobenchmark/build/
android/local.properties
.idea/
.vscode/
.claude/settings.local.json

# テスト実行センチネル（コミット時テスト強制 hook のランタイム生成物）
# （.python_tests_passed は 2026-07-06 の Python ゲート撤去で生成者が消滅したため行ごと削除済み）
.claude/.kotlin_tests_passed

# Android Lint のベースライン（check_lint_on_commit hook のランタイム生成物・マシン固有の基準値）
.claude/lint_baseline.json

# 保護ブランチへの明示コミット許可センチネル（ブランチガード hook の一回限り上書き）
.claude/.allow_protected_commit

# stale-check 軽量モードの状態記録（ランタイム生成物）
.claude/.stale_check_state.json

# ab-review プロト評価環境（ソースのみ追跡。ビルド成果物・再生成可能な出力は除外）
ab-review/submission-B/.gradle/
ab-review/submission-B/build/
ab-review/submission-B/output/
ab-review/_compute_logs/
# トップ階層 sample_pdfs/ と同一PDFの重複コピーのため除外（参照はトップを使う）
ab-review/sample_pdfs/

# 機械固有のローカル設定（statusline スクリプト・月次コストキャッシュ）。両OS共有の /mnt/c 上に出るため追跡しない
.claude/statusline-local.sh
.claude/.monthly_cost_cache

# 穴3実機スパイクのローカル資産（正本は sample_pdfs/ と ab-review/golden_regression/。9MB重複を避けコミットしない）
android/app/src/androidTest/assets/spike/

# 縦書きP0計測（2026-07-17）で追加した検体PDF。計25MB とリポジトリを膨らませるため手元保持のみ。
# 既存4件（N1453LW/N2959KI/N5368ML/N6169DZ）は追跡済み＝この6件だけ非追跡という非対称は容量が理由。
# 測定結果自体は .claude/plans/vertical-mode-p0-* に文書として残っており、再取得なしで参照できる。
# ワイルドカードにせず個別列挙するのは、新規検体を足したときに黙って無視されるのを防ぐため。
sample_pdfs/N0833HI.pdf
sample_pdfs/N2367FS.pdf
sample_pdfs/N3957FQ.pdf
sample_pdfs/N7038HV.pdf
sample_pdfs/N8809BK.pdf
