{
  "permissions": {
    "allow": [
      "Bash(cd *android* && *gradlew testDebugUnitTest*)",
      "Bash(cd *python* && python -m unittest test_logic*)",
      "Bash(python -m unittest test_logic*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "MARKER=\"/tmp/claude_skill_injected_${PPID}\"; if [ ! -f \"$MARKER\" ]; then touch \"$MARKER\"; echo 'スキル使用ルール（セッション開始時リマインダー）: ビルド・Gradle作業→/build（java not foundが出たら/buildに復旧手順あり）、アーキテクチャ確認→/architecture、DB/Entityスキーマ変更→/db-migration。これらの場面では自力調査より先にスキルを実行すること。'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/open_in_vscode.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/remind_commit_plan.py\""
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/remind_add_test_permission.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/mark_python_tests_passed.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/block_destructive_migration.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_commit_granularity.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_schema_change.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check_lint_on_commit.py\""
          }
        ]
      }
    ]
  }
}
